# Server only. Never put these variables in a React VITE_* variable.
# Hosted student demo: use NODE_ENV=production and NIBASH_DEMO_MODE=true,
# with PAYMENT_SANDBOX_ENABLED=true and PAYMENT_SANDBOX_PROVIDER=simulated.
NODE_ENV=development
NIBASH_DEMO_MODE=false
PAYMENT_SANDBOX_ENABLED=false
PAYMENT_SANDBOX_PROVIDER=simulated
# Copy the PUBLIC TEST credentials from the official shurjoPay integration-howto page.
SHURJOPAY_SANDBOX_USERNAME=
SHURJOPAY_SANDBOX_PASSWORD=
SHURJOPAY_SANDBOX_PREFIX=NOK
PAYMENT_SANDBOX_RETURN_URL=http://127.0.0.1:5055/api/payment-sandbox/return
