PORT=5000
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/nibash
JWT_SECRET=your_secret_key
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Public natural-language search: opt in after reviewing Gemini terms/data handling.
# Independent from document verification. Credentials can reuse GEMINI_API_KEY.
SEARCH_AI_ENABLED=false
SEARCH_AI_API_KEY=
SEARCH_AI_MODEL=gemini-3.5-flash-lite
SEARCH_AI_TIMEOUT_MS=5000
